# Package-local recipe. Stage checksummed sources with packaging/arch/build.sh.
pkgname=aco-arch-dotfiles-pcmanfm
pkgver=0.3.0
pkgrel=1
pkgdesc='PCManFM file manager configuration'
arch=('any')
url='https://github.com/Akademie-Olympia/aco-arch-dotfiles'
license=('LicenseRef-arch-dotfiles-bundle')
depends=('aco-arch-dotfiles-core>=0.3.0' 'pcmanfm' 'aco-arch-dotfiles-libfm' 'aco-arch-dotfiles-gtk-3.0')
optdepends=()
replaces=('arch-dotfiles-pcmanfm')
conflicts=('arch-dotfiles-pcmanfm')
options=('!strip')
source=('payload.tar.gz')
sha256sums=('__SOURCE_SHA256__')

package() {
    cp -a "$srcdir/usr" "$pkgdir/"
}
